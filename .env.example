NODE_ENV=development

# Meta official provider
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_GRAPH_API_VERSION=v25.0

# Experimental risky providers
ENABLE_RISKY_PROVIDERS=false
IG_USERNAME=
# Put IG password only in your local .env. Never commit it.

# Runner settings
REQUEST_DELAY_MS=5000
PROVIDER_TIMEOUT_MS=30000
MAX_USERNAMES=10
